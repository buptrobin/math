{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0",
    "types": []
  },
  "include": [
    "app.ts",
    "pages/**/*.ts",
    "components/**/*.ts",
    "shared/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "miniprogram_npm",
    "cloudfunctions"
  ]
}
