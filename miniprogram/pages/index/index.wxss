.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #d8e2dc;
  border-radius: 8rpx;
}

.eyebrow {
  color: #2f6f62;
  font-size: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  color: #52616b;
  font-size: 28rpx;
}
