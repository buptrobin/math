.indexPage {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #d8e2dc;
  border-radius: 8rpx;
}

.eyebrow {
  color: #2f6f62;
  font-size: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  color: #52616b;
  font-size: 28rpx;
}

.sectionList {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.lessonButton {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 92rpx;
  padding: 0 22rpx;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #d8e2dc;
  border-radius: 8rpx;
}

.footerActions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
