.indexPage {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #d8e2dc;
  border-radius: 8rpx;
}

.eyebrow {
  color: #2f6f62;
  font-size: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  color: #52616b;
  font-size: 28rpx;
}

.sectionList {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 0 -28rpx;
}

.lessonButton {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 92rpx;
  padding: 0 22rpx;
  text-align: left;
  background: #ffffff;
  border: 1rpx solid #d8e2dc;
  border-radius: 8rpx;
  box-sizing: border-box;
  line-height: 1.2;
}

.lessonOrder {
  flex: 0 0 150rpx;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 700;
}

.lessonTitle {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.footerActions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
