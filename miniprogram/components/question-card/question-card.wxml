<view class="card">
  <view class="meta">
    <text>难度 {{question.difficulty}}</text>
    <text>{{question.examPoint}}</text>
  </view>
  <math-rich-text class="question" content="{{question.questionText}}" />

  <view wx:if="{{displayOptions.length}}" class="options">
    <button
      wx:for="{{displayOptions}}"
      wx:key="label"
      class="option {{selectedChoiceLabel === item.label ? 'selected' : ''}}"
      data-answer="{{item.value}}"
      data-label="{{item.label}}"
      bindtap="selectOption"
    >
      <text class="optionLabel">{{item.label}}.</text>
      <math-rich-text class="optionText" content="{{item.value}}" />
    </button>
  </view>

  <input
    wx:else
    class="answerInput"
    value="{{answer}}"
    placeholder="请输入答案"
    bindinput="onInput"
  />

  <view class="hints" wx:if="{{visibleHints.length}}">
    <math-rich-text wx:for="{{visibleHints}}" wx:key="*this" class="hint" content="{{item}}" />
  </view>

  <view class="actions">
    <button size="mini" bindtap="showHint" disabled="{{visibleHints.length >= question.hints.length}}">提示</button>
    <button size="mini" type="primary" bindtap="submit" disabled="{{!answer && !selectedChoiceLabel}}">提交</button>
  </view>

  <view wx:if="{{result}}" class="result {{result.isCorrect ? 'correct' : 'wrong'}}">
    <text>{{result.isCorrect ? '回答正确' : '再想一想'}}</text>
    <math-rich-text content="{{result.explanation}}" />
    <text wx:if="{{result.commonMistake}}">常见错误：{{result.commonMistake}}</text>
    <text wx:if="{{result.aiReason}}">AI 判断：{{result.aiReason}}</text>
  </view>
</view>
